# Server port
PORT=3000
# Bind to 127.0.0.1 on a VPS when Nginx proxies public traffic.
HOST=0.0.0.0
# PostgreSQL URL (local or hosted)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/adda_db"

# Better Auth Secret (generate a random 32-character string, e.g. using openssl rand -base64 32)
BETTER_AUTH_SECRET="your-32-character-random-secret-key-here"

# Server Base URL (publicly reachable address or localhost in dev)
BETTER_AUTH_URL="https://api.ritzla.in"

# Comma-separated browser origins allowed to call this API
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

# Optional Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 1:1 WebRTC ICE. For reliable calls across mobile networks, configure a TURN
# server using time-limited REST credentials with the same shared secret.
STUN_URL="stun:stun.l.google.com:19302"
TURN_URL=""
TURN_SHARED_SECRET=""

# Public/LAN address reachable from phones for group calls and room voice.
# Open TCP/UDP 40000-49999 toward the media host when deploying.
MEDIA_ANNOUNCED_ADDRESS=""

# Optional Firebase Admin service-account path for background call push.
GOOGLE_APPLICATION_CREDENTIALS=""

# Private Cloudflare R2 bucket for encrypted photo and video blobs.
# Media sharing stays unavailable until all four values are supplied.
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Official MiroTalk P2P service. Keep credentials on the backend only.
MIROTALK_INTERNAL_URL="http://127.0.0.1:3010"
MIROTALK_PUBLIC_URL="https://meet.ritzla.in"
MIROTALK_API_KEY=""
MIROTALK_HOST_USER=""
MIROTALK_HOST_PASSWORD=""
