{
  "expo": {
    "name": "ADDA — Apna Virtual Hangout",
    "slug": "adda",
    "scheme": "adda",
    "version": "0.1.0",
    "orientation": "default",
    "android": {
      "package": "com.adda.virtualhangout",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-router",
      "expo-screen-orientation",
      "expo-secure-store",
      ["expo-camera", { "cameraPermission": "Allow ADDA to scan a friend's QR code.", "recordAudioAndroid": false }],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
