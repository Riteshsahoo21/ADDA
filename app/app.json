{
  "expo": {
    "name": "ADDA",
    "slug": "adda",
    "scheme": "adda",
    "version": "0.1.0",
    "icon": "./assets/images/icon.png",
    "orientation": "default",
    "android": {
      "package": "com.adda.virtualhangout",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "versionCode": 1,
      "usesCleartextTraffic": false,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [
      "./plugins/with-play-signing",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FAF8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 1
        }
      ],
      "expo-screen-orientation",
      "expo-secure-store",
      "expo-sqlite",
      "expo-notifications",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow ADDA to save photos to your gallery.",
          "savePhotosPermission": "Allow ADDA to save photos to your gallery."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ADDA to scan a friend's QR code.",
          "recordAudioAndroid": false
        }
      ],
      "@react-native-google-signin/google-signin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": true,
            "enableBundleCompression": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
